{% assign image_age = image_age | default: 1 %}
<div class="layout layout--col gap--small">
  <div class="stretch" style="min-height:0;width:100%;display:flex;align-items:center;justify-content:center;">{% if image_url %}<img class="image" src="{{ image_url | escape }}" style="width:100%;height:100%;object-fit:contain;" alt="{{ image_title | escape }}">{% endif %}</div>
  <div class="layout layout--row gap--medium" style="width:100%;flex:0 0 108px;">
    <div class="layout layout--col gap--xsmall"><span class="title">Day {{ image_age }}</span><span class="label">Keep it or change it?</span><span class="description">One scan. One choice.</span></div>
    {% if vote_url %}<div style="width:96px;height:96px;flex-shrink:0;">{{ vote_url | qr_code }}</div>{% endif %}
  </div>
</div>
<div class="title_bar"><span class="title">Keep It or Change It</span><span class="instance">Day {{ image_age }}</span></div>
