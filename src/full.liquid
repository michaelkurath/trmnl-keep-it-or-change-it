{% assign image_age = image_age | default: 1 %}
<div class="layout layout--row gap--large">
  <div class="stretch" style="min-width:0;min-height:0;display:flex;align-items:center;justify-content:center;">
    {% if image_url %}<img class="image" src="{{ image_url | escape }}" style="width:100%;height:100%;object-fit:contain;" alt="{{ image_title | escape }}">{% else %}<span class="description">The shared image is temporarily unavailable.</span>{% endif %}
  </div>
  <div class="layout layout--col gap--small" style="width:180px;flex-shrink:0;border-left:1px solid;padding-left:16px;">
    <span class="label label--small">STILL HERE</span>
    <span class="title title--large">Day {{ image_age }}</span>
    <span class="title">Keep it<br>or change it?</span>
    {% if vote_url %}<div style="width:108px;height:108px;">{{ vote_url | qr_code }}</div>{% endif %}
    <span class="description">One scan. One choice.</span>
    <span class="label label--small">Daily at 20:00 UTC</span>
  </div>
</div>
<div class="title_bar"><span class="title">Keep It or Change It</span><span class="instance">{{ image_title }}</span></div>
