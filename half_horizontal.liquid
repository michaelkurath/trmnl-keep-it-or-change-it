{% assign image_age = image_age | default: 1 %}
<div class="layout layout--row gap--medium">
  <div class="stretch" style="min-width:0;min-height:0;display:flex;align-items:center;justify-content:center;">{% if image_url %}<img class="image" src="{{ image_url | escape }}" style="width:100%;height:100%;object-fit:contain;" alt="{{ image_title | escape }}">{% endif %}</div>
  <div class="layout layout--col gap--xsmall" style="width:130px;flex-shrink:0;">
    <span class="title">Day {{ image_age }}</span><span class="label">Keep or change?</span>
    {% if vote_url %}<div style="width:84px;height:84px;">{{ vote_url | qr_code }}</div>{% endif %}
  </div>
</div>
<div class="title_bar"><span class="title">Keep It or Change It</span><span class="instance">Day {{ image_age }}</span></div>
