{% assign image_age = image_age | default: 1 %}
<div class="layout layout--col gap--xsmall">
  <div class="stretch" style="width:100%;min-height:0;display:flex;align-items:center;justify-content:center;">{% if image_url %}<img class="image" src="{{ image_url | escape }}" style="width:100%;height:100%;object-fit:contain;" alt="{{ image_title | escape }}">{% endif %}</div>
</div>
<div class="title_bar"><span class="title">Keep It or Change It</span><span class="instance">Day {{ image_age }}</span></div>
